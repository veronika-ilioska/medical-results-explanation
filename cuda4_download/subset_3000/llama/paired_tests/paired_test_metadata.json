{
  "models": [
    "llama"
  ],
  "metrics": [
    "rouge_l_f1",
    "bertscore_f1"
  ],
  "alpha": 0.05,
  "alternative": "two-sided",
  "difference": "finetuned - base",
  "confidence_level": 0.95,
  "confidence_intervals": "pointwise, unadjusted",
  "correction": "Holm across all requested model/metric tests",
  "family_size": 2,
  "pair_keys": [
    "subject_id",
    "hadm_id",
    "charttime"
  ],
  "allow_partial_pairs": false,
  "runs": {
    "llama": {
      "base": {
        "predictions": "outputs/subset_3000/llama/base/predictions.csv",
        "evaluation": "outputs/subset_3000/llama/base/evaluation/evaluation_results.csv",
        "prediction_rows": 300,
        "rows_selected_for_evaluation": 300,
        "blank_rows_excluded_by_evaluator": 0,
        "evaluated_rows": 300,
        "evaluation_metadata": {
          "input": "outputs/subset_3000/llama/base/predictions.csv",
          "target_column": "generated_text",
          "prediction_column": "base_llama_tabular_output",
          "output_dir": "outputs/subset_3000/llama/base/evaluation",
          "prompt_column": "prompt",
          "folds": 5,
          "seed": 42,
          "max_rows": null,
          "skip_bertscore": false,
          "bertscore_model": "roberta-large",
          "bertscore_device": "cuda:0",
          "bertscore_rescale": false,
          "rows_evaluated": 300
        }
      },
      "finetuned": {
        "predictions": "outputs/subset_3000/llama/finetuned/predictions.csv",
        "evaluation": "outputs/subset_3000/llama/finetuned/evaluation/evaluation_results.csv",
        "prediction_rows": 300,
        "rows_selected_for_evaluation": 300,
        "blank_rows_excluded_by_evaluator": 0,
        "evaluated_rows": 300,
        "evaluation_metadata": {
          "input": "outputs/subset_3000/llama/finetuned/predictions.csv",
          "target_column": "generated_text",
          "prediction_column": "fine_tuned_llama_tabular_output",
          "output_dir": "outputs/subset_3000/llama/finetuned/evaluation",
          "prompt_column": "prompt",
          "folds": 5,
          "seed": 42,
          "max_rows": null,
          "skip_bertscore": false,
          "bertscore_model": "roberta-large",
          "bertscore_device": "cuda:0",
          "bertscore_rescale": false,
          "rows_evaluated": 300
        }
      },
      "matched_panels": 300,
      "base_only": 0,
      "finetuned_only": 0
    }
  }
}
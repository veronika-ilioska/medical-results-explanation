Bootstrap: docker
From: nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04

%labels
    Author medical-results-explanation
    Description CUDA 12.2-compatible vLLM environment for silver-standard generation
    CUDA 12.2
    vLLM 0.6.4

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        python3 \
        python3-pip
    rm -rf /var/lib/apt/lists/*

    python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

    python3 -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu121 \
        torch==2.5.1 \
        torchvision==0.20.1

    # CUDA 12.1 PyTorch/vLLM wheels run on CUDA 12.2 drivers.
    python3 -m pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cu121 \
        vllm==0.6.4 \
        transformers==4.45.2 \
        tokenizers==0.20.3 \
        protobuf==5.28.3 \
        openai==1.51.2 \
        pydantic==2.9.2 \
        bitsandbytes==0.45.5 \
        duckdb==1.4.1 \
        pandas==2.3.2

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONNOUSERSITE=1
    export TOKENIZERS_PARALLELISM=false
    export HF_HOME=/cache/huggingface
    export TRANSFORMERS_CACHE=/cache/huggingface/transformers
    export TMPDIR=/scratch/tmp

%runscript
    exec python3 "$@"

%test
    python3 -c "import torch, transformers, vllm, duckdb, pandas"

%help
    Build from the repository root:
      sudo singularity build \
        medical-results-vllm.sif \
        containers/singularity/Singularity.vllm.def

    Run the vLLM generator:
      singularity exec --nv -B $PWD:/workspace medical-results-vllm.sif \
        python3 /workspace/scripts/silver_standard/generate_silver_standard_vllm.py --help
